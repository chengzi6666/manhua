# ============================================================
# 大阅读精灵漫画家 - 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会上传）
#       cp .env.example .env
# ============================================================

# 【必填】火山(Volcengine Ark) API Key
#   用于：生图 / 背景生成 / 剧本生成 / OCR 文字识别
#   获取：https://console.volcengine.com/ark/  ->  创建 API Key
ARK_API_KEY=your_ark_api_key_here

# 【可选】豆包文本模型（默认 doubao-seed-evolving）
DOUBAO_MODEL_ID=doubao-seed-evolving

# 【可选】火山图像生成模型（默认 doubao-seedream-5-0-lite-260128）
ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128

# 【可选】服务端口（CloudStudio 通常会自动注入 PORT，一般不用改）
# PORT=5000
